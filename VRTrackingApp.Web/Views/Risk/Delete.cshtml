@model VRTrackingApp.Data.Models.Risk
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Delete Risk: " + Model.RiskName;
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="mt-4">Delete Risk</h1>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">← Back to Details</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Confirm Delete</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                Are you sure you want to delete this risk? This action cannot be undone.
            </div>
            <dl class="row mb-4">
                <dt class="col-sm-3">Risk Name</dt>
                <dd class="col-sm-9">@Model.RiskName</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.Status == "Open" ? "primary" : Model.Status == "Mitigated" ? "success" : Model.Status == "Closed" ? "danger" : "secondary")">
                        @Model.Status
                    </span>
                </dd>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger me-2">Delete</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
