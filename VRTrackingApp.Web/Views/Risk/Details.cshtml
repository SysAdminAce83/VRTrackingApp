@model VRTrackingApp.Data.Models.Risk
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Risk Details: " + Model.RiskName;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Risk Details</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Risk">Risks</a></li>
        <li class="breadcrumb-item active">Details</li>
    </ol>

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary me-2">Edit</a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Risk Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Risk Name</dt>
                        <dd class="col-sm-9">@Model.RiskName</dd>
                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>
                        <dt class="col-sm-3">Business Impact</dt>
                        <dd class="col-sm-9">@Model.BusinessImpact</dd>
                        <dt class="col-sm-3">Likelihood</dt>
                        <dd class="col-sm-9">@Model.Likelihood</dd>
                        <dt class="col-sm-3">Risk Score (1-25)</dt>
                        <dd class="col-sm-9">@Model.RiskScore</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Ownership & Dates</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Owner</dt>
                        <dd class="col-sm-9">@(Model.Owner?.UserName ?? "Unassigned")</dd>
                        <dt class="col-sm-3">Created At</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-3">Updated At</dt>
                        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
                        <dt class="col-sm-3">Review Date</dt>
                        <dd class="col-sm-9">@(Model.ReviewDate?.ToString("yyyy-MM-dd") ?? "Not set")</dd>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Status & Notes</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <strong>Status:</strong>
                        <span class="badge bg-@(Model.Status == "Open" ? "primary" : Model.Status == "Mitigated" ? "success" : Model.Status == "Closed" ? "danger" : "secondary")">
                            @Model.Status
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <strong>Notes:</strong>
                        <div>@Model.Notes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
