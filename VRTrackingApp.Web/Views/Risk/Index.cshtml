@model IEnumerable<VRTrackingApp.Data.Models.Risk>
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Risks";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Risks</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Risks</li>
    </ol>

    <div class="row mb-3">
        <div class="col-md-4">
            <a asp-action="Create" class="btn btn-primary btn-sm">Create New Risk</a>
        </div>
        <div class="col-md-8 text-end">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-3">
                    <input type="text" name="riskName" class="form-control form-control-sm" placeholder="Risk name" value="@ViewBag.RiskName" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="status" class="form-control form-control-sm" placeholder="@ViewBag.Status" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-exclamation-triangle"></i> Risk Register
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Risk Name</th>
                            <th>Description</th>
                            <th>Business Impact</th>
                            <th>Likelihood</th>
                            <th>Risk Score</th>
                            <th>Owner</th>
                            <th>Review Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var risk in Model)
                        {
                            <tr>
                                <td>@risk.RiskName</td>
                                <td class="small" style="max-width:200px;">@risk.Description</td>
                                <td>@risk.BusinessImpact</td>
                                <td>@risk.Likelihood</td>
                                <td>@risk.RiskScore</td>
                                <td>@(risk.Owner?.UserName ?? "Unassigned")</td>
                                <td>@(risk.ReviewDate?.ToString("yyyy-MM-dd") ?? "Not set")</td>
                                <td>
                                    <span class="badge bg-@(risk.Status == "Open" ? "primary" : risk.Status == "Mitigated" ? "success" : risk.Status == "Closed" ? "danger" : "secondary")">
                                        @risk.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@risk.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@risk.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@risk.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
