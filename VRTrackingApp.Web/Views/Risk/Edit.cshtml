@model VRTrackingApp.Data.Models.Risk
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Edit Risk - " + Model.RiskName;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Risk</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Risk">Risks</a></li>
        <li class="breadcrumb-item active">Edit @Html.ValueFor(m => m.RiskName)</li>
    </ol>

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-edit"></i> Edit Risk
        </div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="RiskName" class="form-label">Risk Name *</label>
                            <input asp-for="RiskName" class="form-control" />
                            <span asp-validation-for="RiskName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="BusinessImpact" class="form-label">Business Impact *</label>
                            <input asp-for="BusinessImpact" class="form-control" list="businessImpactList" />
                            <datalist id="businessImpactList">
                                <option value="Low"></option>
                                <option value="Medium"></option>
                                <option value="High"></option>
                                <option value="Critical"></option>
                            </datalist>
                            <span asp-validation-for="BusinessImpact" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Likelihood" class="form-label">Likelihood *</label>
                            <input asp-for="Likelihood" class="form-control" list="likelihoodList" />
                            <datalist id="likelihoodList">
                                <option value="Rare"></option>
                                <option value="Unlikely"></option>
                                <option value="Possible"></option>
                                <option value="Likely"></option>
                                <option value="Almost Certain"></option>
                            </datalist>
                            <span asp-validation-for="Likelihood" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="RiskScore" class="form-label">Risk Score (1-25) *</label>
                            <input asp-for="RiskScore" class="form-control" type="number" min="1" max="25" />
                            <span asp-validation-for="RiskScore" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="OwnerUserId" class="form-label">Owner</label>
                            <select asp-for="OwnerUserId" asp-items="(SelectList)ViewBag.OwnerUserId" class="form-select">
                                <option value="">-- Select Owner --</option>
                            </select>
                            <span asp-validation-for="OwnerUserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ReviewDate" class="form-label">Review Date</label>
                            <input asp-for="ReviewDate" class="form-control" type="date" />
                            <span asp-validation-for="ReviewDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status *</label>
                            <input asp-for="Status" class="form-control" list="statusList" />
                            <datalist id="statusList">
                                <option value="Open"></option>
                                <option value="Mitigated"></option>
                                <option value="Closed"></option>
                                <option value="Accepted"></option>
                            </datalist>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
