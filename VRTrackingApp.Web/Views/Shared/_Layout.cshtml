<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>try{var t=localStorage.getItem("theme");if(t){document.documentElement.setAttribute("data-theme",t);}else if(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches){document.documentElement.setAttribute("data-theme","dark");}}catch(e){}</script>
    <title>@(ViewData["Title"]?.ToString() ?? "RemediateVR") — Vulnerability Remediation Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="rail-backdrop" id="railBackdrop"></div>

        <!-- Left navigation -->
        <aside class="app-rail" id="appRail">
            <div class="rail-brand">
                <span class="brand-mark">RVR</span>
                <span class="brand-text">Remediate<br />VR</span>
            </div>
            <nav class="rail-nav">
                <a class="nav-link @navActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-ico">▦</span> Dashboard
                </a>
                <a class="nav-link @navActive("Upload")" asp-controller="Upload" asp-action="Index">
                    <span class="nav-ico">⤓</span> Upload Scan
                </a>
                <a class="nav-link @navActive("Groups")" asp-controller="Upload" asp-action="Groups"><span class="nav-ico">GL</span> Scan Groups</a>
                <a class="nav-link @navActive("Scans")" asp-controller="Scans" asp-action="Index">
                    <span class="nav-ico">☰</span> Scan History
                </a>
                <a class="nav-link @navActive("Hosts")" asp-controller="Hosts" asp-action="Index">
                    <span class="nav-ico">🖥</span> Hosts
                </a>
                <a class="nav-link @navActive("Assets")" asp-controller="Asset" asp-action="Index">
                    <span class="nav-ico">🗂</span> Assets
                </a>
                <a class="nav-link @navActive("Vulnerabilities")" asp-controller="Vulnerabilities" asp-action="Index">
                    <span class="nav-ico">⚠</span> Vulnerabilities
                </a>
                <a class="nav-link @navActive("Exceptions")" asp-controller="Exceptions" asp-action="Index">
                    <span class="nav-ico">⏸</span> Exceptions
                </a>
                <a class="nav-link @navActive("Reports")" asp-controller="Reports" asp-action="Index">
                    <span class="nav-ico">▤</span> Reports
                </a>
                <a class="nav-link @navActive("Audit")" asp-controller="Audit" asp-action="Index">
                    <span class="nav-ico">🕑</span> Audit Log
                </a>
                <a class="nav-link @navActive("Admin")" asp-controller="Admin" asp-action="Index">
                    <span class="nav-ico">⚙</span> Admin Settings
                </a>
            </nav>
            <div class="rail-foot">v1.0 · Nessus ingestion</div>
        </aside>

        <!-- Main -->
        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="rail-toggle" id="railToggle" aria-label="Toggle navigation" aria-controls="appRail" aria-expanded="false">
                    <span class="rail-toggle-bar"></span><span class="rail-toggle-bar"></span><span class="rail-toggle-bar"></span>
                </button>
                <form class="topbar-search" asp-controller="Search" asp-action="Index" method="get">
                    <input type="search" name="q" class="form-control" placeholder="Search host, IP, CVE, plugin…" />
                </form>
                <div class="topbar-filters">
                    <select class="form-select form-select-sm" id="cycleFilter" title="Scan cycle">
                        <option value="">All cycles</option>
                    </select>
                    <input type="date" class="form-control form-control-sm" id="dateFilter" title="Date filter" />
                </div>
                <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle dark mode">🌓</button>
                <div class="topbar-user">
                    @await Component.InvokeAsync("Notification")
                    @if (Context.User.Identity?.IsAuthenticated == true)
                    {
                        // Prefer the friendly display name from the DB; fall back to the Windows name.
                        var displayName = Context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                            ?? Context.User.Identity.Name ?? "User";
                        var role = Context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        var initials = string.Concat(displayName.Split(new[] { ' ', '\\' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[..1]).ToArray()).ToUpper();
                        <span class="user-chip" title="Signed in via Windows / Active Directory">
                            @initials <small>@displayName@(role is null ? "" : $" · {role}")</small>
                        </span>
                    }
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

@await Html.PartialAsync("_ShortcutHelp")
    @await Html.PartialAsync("_ToastContainer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @functions {
        string navActive(string controller)
        {
            var c = Context.GetRouteValue("controller")?.ToString();
            return string.Equals(c, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }
    }
</body>
</html>

