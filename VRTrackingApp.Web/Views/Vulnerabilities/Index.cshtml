@model IEnumerable<VRTrackingApp.Data.Models.VulnerabilityInstance>
@{
    var q = (string?)ViewBag.Q;
    var sev = (string?)ViewBag.Severity;
    var st = (string?)ViewBag.Status;
}

<div class="page-head">
    <div><h1>Vulnerabilities</h1><p class="page-sub">Primary triage working area — filter, search, and remediate</p></div>
</div>

<form class="toolbar" asp-action="Index" method="get">
    <input class="form-control" name="q" placeholder="Search CVE, plugin, host, IP…" value="@q" />
    <select class="form-select" name="severity">
        <option value="All" selected="@(sev == "All" || sev == null ? "selected" : "")">All severities</option>
        @foreach (var s in new[] { "Critical", "High", "Medium", "Low", "Info" })
        { <option value="@s" selected="@(sev == s ? "selected" : "")">@s</option> }
    </select>
    <select class="form-select" name="status">
        <option value="All" selected="@(st == "All" || st == null ? "selected" : "")">All statuses</option>
        @foreach (var s in new[] { "Open", "Fixed", "Exception" })
        { <option value="@s" selected="@(st == s ? "selected" : "")">@s</option> }
    </select>
    <button class="btn btn-outline-primary">Apply</button>
    <a class="btn btn-link" asp-action="Index">Reset</a>
</form>

<div class="card">
    <div class="card-b p-0">
        <table class="table table-sm mb-0">
            <thead>
                <tr><th>Sev</th><th>Plugin</th><th>Finding</th><th>Host</th><th>Owner</th><th>Due</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td>@Html.Raw(VRTrackingApp.Web.Html.UiHelpers.Sev(i.VulnerabilityFinding!.Severity))</td>
                        <td>@i.VulnerabilityFinding.PluginId</td>
                        <td>@i.VulnerabilityFinding.PluginName</td>
                        <td>@i.AssetHost?.HostName</td>
                        <td>@i.Owner?.DisplayName</td>
                        <td>@(i.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@Html.Raw(VRTrackingApp.Web.Html.UiHelpers.Pill(i.Status))</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@i.Id">Open</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="8" class="empty">No findings match the filters.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
