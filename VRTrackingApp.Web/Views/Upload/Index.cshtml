@{
    var srcTypes = (string[])ViewBag.SourceTypes;
}

<div class="page-head">
    <div>
        <h1>Upload Scan Report</h1>
        <p class="page-sub">Import a Nessus CSV or PDF scan. Files are validated, hashed and stored with a server-generated name before any data is saved.</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-b">
        <form method="post" enctype="multipart/form-data" asp-action="Validate" id="uploadForm">
            @Html.AntiForgeryToken()
            <div class="dropzone mb-3" id="dz">
                <div class="dz-ico">⤓</div>
                <div><b>Drag &amp; drop</b> a Nessus <code>.csv</code>, <code>.pdf</code> or <code>.nessus</code> here</div>
                <div class="text-muted small">or click to browse · max 100 MB</div>
                <input type="file" name="file" id="fileInput" accept=".csv,.pdf,.nessus,.xml" hidden />
                <div id="fileName" class="mt-2 fw-bold"></div>
            </div>

            <div class="form-section">
                <div class="mb-3">
                    <label class="form-label">Scan Name</label>
                    <input class="form-control" name="scanName" placeholder="e.g. March Server Scan" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Scan Cycle Label</label>
                    <input class="form-control" name="cycleLabel" placeholder="e.g. March Monthly" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Scan Date</label>
                    <input type="date" class="form-control" name="scanDate" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Source Type</label>
                    <select class="form-select" name="sourceType">
                        @foreach (var t in srcTypes) { <option>@t</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Comments / Notes</label>
                    <input class="form-control" name="notes" placeholder="Optional context…" />
                </div>
            </div>

            <button class="btn btn-primary" type="submit">Validate &amp; Preview →</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const dz = document.getElementById('dz');
        const input = document.getElementById('fileInput');
        const fn = document.getElementById('fileName');
        dz.addEventListener('click', () => input.click());
        input.addEventListener('change', () => { if (input.files.length) fn.textContent = input.files[0].name; });
        ['dragover','dragenter'].forEach(e => dz.addEventListener(e, ev => { ev.preventDefault(); dz.classList.add('drag'); }));
        ['dragleave','drop'].forEach(e => dz.addEventListener(e, ev => { ev.preventDefault(); dz.classList.remove('drag'); }));
        dz.addEventListener('drop', ev => { if (ev.dataTransfer.files.length) { input.files = ev.dataTransfer.files; fn.textContent = input.files[0].name; } });
    </script>
}

