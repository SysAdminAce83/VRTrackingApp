@model IEnumerable<VRTrackingApp.Data.Models.RiskAcceptance>
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Risk Acceptances";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Risk Acceptances</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Risk Acceptances</li>
    </ol>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-shield-halved"></i> Active Risk Acceptances
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>CVE</th>
                            <th>Finding</th>
                            <th>Control</th>
                            <th>Framework</th>
                            <th>Justification</th>
                            <th>Accepted By</th>
                            <th>Accepted At</th>
                            <th>Expiry</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ra in Model)
                        {
                            <tr>
                                <td>@ra.Finding.Cve</td>
                                <td>@ra.Finding.PluginName</td>
                                <td>@ra.Control.ControlId</td>
                                <td>@ra.Control.Framework</td>
                                <td class="small" style="max-width:300px;">@ra.Justification</td>
                                <td>@ra.AcceptedBy</td>
                                <td>@ra.AcceptedAt.ToString("yyyy-MM-dd")</td>
                                <td>@(ra.ExpiryDate?.ToString("yyyy-MM-dd") ?? "No expiry")</td>
                                <td>
                                    <span class="badge bg-@(ra.Status == RiskAcceptanceStatus.Active ? "success" : ra.Status == RiskAcceptanceStatus.Expired ? "warning" : "danger")">
                                        @ra.Status
                                    </span>
                                </td>
                                <td>
                                    @if (ra.Status == RiskAcceptanceStatus.Active)
                                    {
                                        <form asp-action="Revoke" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@ra.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Revoke this risk acceptance?')">Revoke</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>