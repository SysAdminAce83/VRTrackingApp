@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access denied";
    var winName = Context.User?.Identity?.Name;
}
<div class="auth-wrap">
    <div class="auth-card card">
        <div class="card-b text-center">
            <h4>Access denied</h4>
            <p class="text-muted">
                You are signed in with your Windows account
                @if (!string.IsNullOrEmpty(winName))
                {
                    <strong>@winName</strong>
                },
                but this account has not been granted access to the Remediation Console.
            </p>
            <p class="text-muted">Please contact your administrator to request access.</p>
        </div>
    </div>
</div>
