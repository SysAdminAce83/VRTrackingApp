@model IEnumerable<VRTrackingApp.Data.Models.ControlLibrary>
@using VRTrackingApp.Data.Models
@{
    ViewData["Title"] = "Control Library";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Control Library</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="ControlLibrary">Control Library</a></li>
        <li class="breadcrumb-item active">List</li>
    </ol>

    <div class="row mb-3">
        <div class="col-md-4">
            <a asp-action="Create" class="btn btn-primary btn-sm">Create New Control</a>
        </div>
        <div class="col-md-8 text-end">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-3">
                    <input type="text" name="controlId" class="form-control form-control-sm" placeholder="Control ID" value="@ViewBag.ControlId" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="domain" class="form-control form-control-sm" placeholder="Domain" value="@ViewBag.Domain" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-list-alt"></i> Control List
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Control ID</th>
                            <th>Domain</th>
                            <th>Control Name</th>
                            <th>Description</th>
                            <th>Objective</th>
                            <th>Owner</th>
                            <th>Frequency</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var control in Model)
                        {
                            <tr>
                                <td>@control.ControlId</td>
                                <td>@control.Domain</td>
                                <td>@control.ControlName</td>
                                <td class="small" style="max-width:200px;">@control.ControlDescription</td>
                                <td class="small" style="max-width:150px;">@control.Objective</td>
                                <td>@(control.ControlOwner ?? "Unassigned")</td>
                                <td>@(control.Frequency ?? "Not set")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@control.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@control.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@control.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
