@model IEnumerable<VRTrackingApp.Data.Models.ExceptionRecord>
@using VRTrackingApp.Data.Models
@{
    var kpi = (Dictionary<string, int>)(ViewData["Kpi"] ?? new Dictionary<string, int>());
}
<div id="exceptionsRegion">
<div class="kpi-row mb-3">
    <div class="kpi-card"><div class="kpi-val">@kpi["Active"]</div><div class="kpi-lbl">Active</div></div>
    <div class="kpi-card kpi-warn"><div class="kpi-val">@kpi["Pending"]</div><div class="kpi-lbl">Pending Approval</div></div>
    <div class="kpi-card kpi-danger"><div class="kpi-val">@kpi["Critical"]</div><div class="kpi-lbl">Critical Exceptions</div></div>
    <div class="kpi-card kpi-warn"><div class="kpi-val">@kpi["Expiring30"]</div><div class="kpi-lbl">Expiring &lt;30d</div></div>
    <div class="kpi-card"><div class="kpi-val">@kpi["Expired"]</div><div class="kpi-lbl">Expired</div></div>
    <div class="kpi-card kpi-danger"><div class="kpi-val">@kpi["Rejected"]</div><div class="kpi-lbl">Rejected</div></div>
    <div class="kpi-card"><div class="kpi-val">@kpi["Closed"]</div><div class="kpi-lbl">Closed</div></div>
</div>

<form method="get" class="toolbar mb-3" data-ajax="true" data-ajax-target="#exceptionsRegion">
    <select name="status" class="form-select form-select-sm" onchange="this.form.requestSubmit()">
        <option value="All" selected="@(ViewBag.Status == "All" || ViewBag.Status == null ? "selected" : "")">All statuses</option>
        @foreach (var s in Enum.GetValues<ExceptionStatus>())
        { <option value="@s" selected="@(ViewBag.Status == s.ToString() ? "selected" : "")">@VRTrackingApp.Data.Models.ExceptionStatusLabels.For(s)</option> }
    </select>
    <select name="severity" class="form-select form-select-sm" onchange="this.form.requestSubmit()">
        <option value="All" selected="@(ViewBag.Severity == "All" || ViewBag.Severity == null ? "selected" : "")">All severities</option>
        @foreach (var s in new[] { "Critical", "High", "Medium", "Low", "Info" })
        { <option value="@s" selected="@(ViewBag.Severity == s ? "selected" : "")">@s</option> }
    </select>
    <select name="risk" class="form-select form-select-sm" onchange="this.form.requestSubmit()">
        <option value="All" selected="@(ViewBag.Risk == "All" || ViewBag.Risk == null ? "selected" : "")">All risk</option>
        @foreach (var r in Enum.GetValues<RiskLevel>())
        { <option value="@r" selected="@(ViewBag.Risk == r.ToString() ? "selected" : "")">@r.Humanize()</option> }
    </select>
    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index")">Reset</a>
</form>

<div class="card admin-card-wide">
    <div class="card-h"><span>Exceptions</span><span class="card-h-sub">@Model.Count() shown</span></div>
    <div class="card-b p-0">
        <div class="table-scroll table-scroll-wide">
        <div class="table-scroll table-scroll-wide">
            <table class="table table-sm mb-0 align-middle" data-sortable>
                <thead>
                    <tr><th data-sort="0" data-sort-label="ID">ID</th><th data-sort="1" data-sort-label="Host">Host</th><th data-sort="2" data-sort-label="Finding">Finding</th><th data-sort="sev" data-sort-label="Severity">Severity</th><th data-sort="risk" data-sort-label="Risk">Risk</th><th data-sort="5" data-sort-label="Owner">Owner</th><th data-sort="6" data-sort-label="First Approver">First Approver</th><th data-sort="exp" data-sort-label="Expiry">Expiry</th><th data-sort="st" data-sort-label="Status">Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var f = e.VulnerabilityInstance?.VulnerabilityFinding;
                        var host = e.VulnerabilityInstance?.AssetHost;
                        var sevRank = new Dictionary<string,int>{["Critical"]=4,["High"]=3,["Medium"]=2,["Low"]=1,["Info"]=0,["None"]=0,[""]=0};
                        var riskRank = new Dictionary<string,int>{["Critical"]=4,["High"]=3,["Medium"]=2,["Low"]=1,[""]=0};
                        var sevKey = sevRank.TryGetValue(f?.Severity ?? "", out var sk) ? sk : 0;
                        var riskKey = riskRank.TryGetValue(e.OverallRisk?.ToString() ?? "", out var rk) ? rk : 0;
                        var stKey = e.Status.ToString();
                        var expKey = e.ExpiryDate?.ToString("yyyy-MM-dd") ?? "9999-12-31";
                        <tr>
                            <td class="fw-600" data-key="0">#@e.Id</td>
                            <td data-key="1">@(host?.HostName ?? "—")</td>
                            <td data-key="2">@(f?.PluginName ?? "—")</td>
                            <td data-key="@sevKey">@Html.Raw(VRTrackingApp.Web.Html.UiHelpers.Sev(f?.Severity))</td>
                            <td data-key="@riskKey">@VRTrackingApp.Web.Html.UiHelpers.RiskBadge(e.OverallRisk)</td>
                            <td class="text-muted" data-key="5">@(e.Owner?.DisplayName ?? "Unassigned")</td>
                            <td class="text-muted" data-key="6">@VRTrackingApp.Web.Services.Exceptions.ExceptionRoutingService.RoleLabel(e.Stage1Role ?? "—")</td>
                            <td class="text-muted" data-key="@expKey">@(e.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td data-key="@stKey">@VRTrackingApp.Web.Html.UiHelpers.StatusBadge(e.Status)</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@e.Id">View</a></td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="10" class="empty">No exceptions match the filter.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

