@model VRTrackingApp.Data.Models.ExceptionRecord
@using VRTrackingApp.Data.Models
@{
    var f = Model.VulnerabilityInstance?.VulnerabilityFinding;
    var host = Model.VulnerabilityInstance?.AssetHost;
    var canAct = (bool)ViewBag.CanAct;
    var isOwner = (bool)ViewBag.IsOwner;
}
<div class="page-head">
    <div>
        <h1>Exception #@Model.Id</h1>
        <p class="page-sub">@(f?.PluginName ?? "Vulnerability") on @(host?.HostName ?? "—")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @StatusBadge(Model.Status)
        <a class="btn btn-outline-secondary" asp-action="Index">← Register</a>
    </div>
</div>

@if (canAct)
{
    <div class="card mb-3 border-primary">
        <div class="card-h">Approval Action <span class="card-h-sub">@VRTrackingApp.Data.Models.ExceptionStatusLabels.For(Model.Status)</span></div>
        <div class="card-b">
            <form method="post" asp-action="Decide" asp-route-id="@Model.Id" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label">Decision</label>
                    <select class="form-select" name="decision" required>
                        <option value="approve">Approve</option>
                        <option value="reject">Reject</option>
                        <option value="info">Need More Information</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Comment (required)</label>
                    <input type="text" class="form-control" name="comment" required />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Submit</button>
                </div>
            </form>
        </div>
    </div>
}

@{
    bool canResubmit = isOwner || User.IsInRole(AppRoles.Admin);
    var infoStep = Model.ApprovalSteps
        .Where(s => s.Decision == ApprovalDecision.NeedMoreInfo)
        .OrderByDescending(s => s.StepOrder)
        .FirstOrDefault();
}

@if (Model.Status == ExceptionStatus.NeedMoreInfo)
{
    <div class="card mb-3 border-warning">
        <div class="card-h">More Information Requested <span class="card-h-sub">awaiting your update</span></div>
        <div class="card-b">
            @if (infoStep != null && !string.IsNullOrWhiteSpace(infoStep.Comment))
            {
                <div class="ac-comment mb-2">@infoStep.Comment</div>
            }
            <p class="text-muted mb-3">The approver needs more detail before continuing. Add the information as a comment and resubmit to return the exception to the approval queue.</p>
            @if (canResubmit)
            {
                <form method="post" asp-action="Resubmit" asp-route-id="@Model.Id" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-9">
                        <label class="form-label">Update / note to approver</label>
                        <input type="text" class="form-control" name="comment" placeholder="e.g. Added firewall rule screenshot and vendor ETA" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100">Resubmit</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-success mb-0">An approver or the exception owner can resubmit this once the information is provided.</div>
            }
        </div>
    </div>
}

<div class="detail-grid">
    <div>
        <div class="card mb-3">
            <div class="card-h">Summary</div>
            <div class="card-b">
                <div class="field-grid">
                    <div class="field"><div class="f-label">Plugin</div><div class="f-val">@(f?.PluginId.ToString() ?? "—")</div></div>
                    <div class="field"><div class="f-label">Asset</div><div class="f-val">@(host?.HostName ?? "—")</div></div>
                    <div class="field"><div class="f-label">Severity</div><div class="f-val">@Html.Raw(VRTrackingApp.Web.Html.UiHelpers.Sev(f?.Severity))</div></div>
                    <div class="field"><div class="f-label">CVSS</div><div class="f-val">@(f?.CvssV3BaseScore?.ToString("0.0") ?? "—")</div></div>
                    <div class="field"><div class="f-label">Status</div><div class="f-val">@StatusBadge(Model.Status)</div></div>
                    <div class="field"><div class="f-label">Owner</div><div class="f-val">@(Model.Owner?.DisplayName ?? "Unassigned")</div></div>
                    <div class="field"><div class="f-label">Review Date</div><div class="f-val">@(Model.NextReviewDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div class="field"><div class="f-label">Expiry</div><div class="f-val">@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div class="field"><div class="f-label">Risk</div><div class="f-val">@RiskBadge(Model.OverallRisk)</div></div>
                    <div class="field"><div class="f-label">First Approver</div><div class="f-val">@VRTrackingApp.Web.Services.Exceptions.ExceptionRoutingService.RoleLabel(Model.Stage1Role ?? "—")</div></div>
                </div>
                <div class="field mt-2"><div class="f-label">Reason</div><div class="f-val">@Model.Reason</div></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-h">Justifications &amp; Risk</div>
            <div class="card-b">
                <div class="field"><div class="f-label">Why not fixable</div><div class="f-val">@(Model.NonFixableReason?.Humanize() ?? "—")@(Model.NonFixableReason == NonFixableReason.Other ? $" — {Model.OtherReasonText}" : "")</div></div>
                <div class="field"><div class="f-label">Technical</div><div class="f-val">@(Model.TechnicalJustification ?? "—")</div></div>
                <div class="field"><div class="f-label">Business (downtime)</div><div class="f-val">@(Model.DowntimeConstraint ?? "—")</div></div>
                <div class="field"><div class="f-label">Business impact</div><div class="f-val">@(Model.BusinessImpact ?? "—")</div></div>
                <div class="row g-2">
                    <div class="col"><div class="field"><div class="f-label">Likelihood</div><div class="f-val">@(Model.Likelihood?.Humanize() ?? "—")</div></div></div>
                    <div class="col"><div class="field"><div class="f-label">Impact</div><div class="f-val">@(Model.Impact?.Humanize() ?? "—")</div></div></div>
                    <div class="col"><div class="field"><div class="f-label">Exploitability</div><div class="f-val">@(Model.Exploitability?.Humanize() ?? "—")</div></div></div>
                    <div class="col"><div class="field"><div class="f-label">Exposure</div><div class="f-val">@(Model.InternetExposure?.Humanize() ?? "—")</div></div></div>
                </div>
                <div class="field mt-2"><div class="f-label">CIA Impact</div><div class="f-val">@Cia()</div></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-h">Mitigation</div>
            <div class="card-b">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Mitigation</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.Mitigations)
                        {
                            <tr>
                                <td>@m.Description</td>
                                <td>@MitStatus(m.Status)</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#mit-@m.Id">Edit</button>
                                    <form method="post" asp-action="DeleteMitigation" asp-route-id="@Model.Id" asp-route-mitigationId="@m.Id" class="d-inline" onsubmit="return confirm('Delete this mitigation?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger">✕</button>
                                    </form>
                                </td>
                            </tr>
                            <tr class="collapse" id="mit-@m.Id"><td colspan="3">
                                <form method="post" asp-action="EditMitigation" asp-route-id="@Model.Id" asp-route-mitigationId="@m.Id" style="display:grid;grid-template-columns:1fr 200px auto;gap:10px;align-items:end;">
                                    @Html.AntiForgeryToken()
                                    <input type="text" class="form-control form-control-sm" name="description" value="@m.Description" />
                                    <select class="form-select form-select-sm" name="status">
                                        @foreach (var s in Enum.GetValues<MitigationStatus>())
                                        { <option value="@s" selected="@(m.Status == s)">@s.Humanize()</option> }
                                    </select>
                                    <button class="btn btn-primary btn-sm" style="white-space:nowrap;">Save</button>
                                </form>
                            </td></tr>
                        }
                        @if (Model.Mitigations.Count == 0) { <tr><td colspan="3" class="text-muted">None recorded.</td></tr> }
                    </tbody>
                </table>
                <form method="post" asp-action="AddMitigation" asp-route-id="@Model.Id" style="display:grid;grid-template-columns:1fr 200px auto;gap:10px;align-items:end;" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="text" class="form-control form-control-sm" name="description" placeholder="Add a mitigation…" required />
                    <select class="form-select form-select-sm" name="status">
                        @foreach (var s in Enum.GetValues<MitigationStatus>()) { <option value="@s">@s.Humanize()</option> }
                    </select>
                    <button class="btn btn-outline-primary btn-sm" style="white-space:nowrap;">Add mitigation</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-h">Existing Security Controls</div>
            <div class="card-b">
                @if (Model.SecurityControls.Count == 0) { <span class="text-muted">None recorded.</span> }
                else { <div class="d-flex flex-wrap gap-2">@foreach (var c in Model.SecurityControls) { <span class="chip">@c.ControlName</span> }</div> }
            </div>
        </div>
    </div>

    <div>
        <div class="card mb-3">
            <div class="card-h">Approval History</div>
            <div class="card-b">
                <ol class="approve-chain">
                    @foreach (var s in Model.ApprovalSteps.OrderBy(x => x.StepOrder))
                    {
                        <li class="@StepClass(s.Decision)">
                            <div class="ac-stage">@StageLabel(s.Stage) <span class="ac-role">@VRTrackingApp.Web.Services.Exceptions.ExceptionRoutingService.RoleLabel(s.RequiredRole)</span></div>
                            <div class="ac-decision">@s.Decision.Humanize()</div>
                            @if (s.DecisionBy != null) { <div class="ac-by">@s.DecisionBy.DisplayName — @(s.DecisionAt?.ToString("yyyy-MM-dd") ?? "")</div> }
                            @if (!string.IsNullOrWhiteSpace(s.Comment)) { <div class="ac-comment">@s.Comment</div> }
                        </li>
                    }
                </ol>
                @if (Model.RejectionReason != null) { <div class="alert alert-danger mt-2">Rejected: @Model.RejectionReason</div> }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-h">
                <span>Evidence</span>
                <span class="card-h-sub">@Model.Evidence.Count file@(Model.Evidence.Count == 1 ? "" : "s")</span>
            </div>
            <div class="card-b">
                @if (Model.Evidence.Count == 0)
                {
                    <div class="ev-empty">No evidence attached yet.</div>
                }
                else
                {
                    <ul class="ev-grid">
                        @foreach (var e in Model.Evidence)
                        {
                            <li class="ev-item">
                                <div class="ev-ico">📄</div>
                                <div class="ev-meta">
                                    <a class="ev-name" href="@Url.Action("DownloadEvidence", new { id = e.Id })">@e.OriginalFileName</a>
                                    <div class="ev-sub">@e.EvidenceType.Humanize() · @(e.SizeBytes / 1024) KB</div>
                                </div>
                                <form method="post" asp-action="DeleteEvidence" asp-route-id="@Model.Id" asp-route-evidenceId="@e.Id" onsubmit="return confirm('Delete this evidence file?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ev-del" title="Delete">✕</button>
                                </form>
                            </li>
                        }
                    </ul>
                }

                <form method="post" asp-action="UploadEvidence" asp-route-id="@Model.Id" enctype="multipart/form-data" class="ev-upload">
                    @Html.AntiForgeryToken()
                    <div class="ev-file">
                        <input type="file" id="evFile" class="form-control form-control-sm" name="evidence" multiple required
                               onchange="document.getElementById('evFileLabel').textContent = this.files.length ? Array.from(this.files).map(f=>f.name).join(', ') : 'Choose files or drop here…'" />
                        <label id="evFileLabel" for="evFile" class="ev-file-label">Choose files or drop here…</label>
                    </div>
                    <select class="form-select form-select-sm ev-type" name="evidenceType" aria-label="Evidence type">
                        @foreach (var t in Enum.GetValues<EvidenceType>()) { <option value="@t">@t.Humanize()</option> }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm ev-btn">Upload</button>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-h">Vendor Responses</div>
            <div class="card-b">
                @foreach (var v in Model.VendorResponses)
                {
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="field"><div class="f-label">@v.Vendor</div><div class="f-val">@v.ResponseText @(v.PatchEtaDate?.ToString("(ETA yyyy-MM-dd)") ?? "")</div></div>
                        <form method="post" asp-action="DeleteVendorResponse" asp-route-id="@Model.Id" asp-route-vendorResponseId="@v.Id" class="d-inline" onsubmit="return confirm('Delete this vendor response?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </div>
                }
                @if (Model.VendorResponses.Count == 0) { <span class="text-muted">None recorded.</span> }
                <form method="post" asp-action="AddVendorResponse" asp-route-id="@Model.Id" style="display:grid;grid-template-columns:1.2fr 2fr 170px auto;gap:10px;align-items:end;" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="text" class="form-control form-control-sm" name="vendor" placeholder="Vendor" required />
                    <input type="text" class="form-control form-control-sm" name="responseText" placeholder="Response…" required />
                    <input type="date" class="form-control form-control-sm" name="patchEtaDate" title="Patch ETA" />
                    <button class="btn btn-outline-primary btn-sm" style="white-space:nowrap;">Add</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-h">Comments</div>
            <div class="card-b">
                <ul class="timeline">
                    @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
                    { <li><div><b>@(c.AuthorDisplayName ?? c.User?.DisplayName)</b></div><div class="t-when">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div><div class="small">@c.Body</div></li> }
                    @if (Model.Comments.Count == 0) { <li class="text-muted">No comments.</li> }
                </ul>
                @if (isOwner || canAct)
                {
                    <form method="post" asp-action="AddComment" asp-route-id="@Model.Id" class="mt-2">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" class="form-control" name="body" placeholder="Add a comment…" />
                            <button class="btn btn-outline-primary">Post</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string Cia()
    {
        var parts = new List<string>();
        if (Model.AffectsConfidentiality) parts.Add("Confidentiality");
        if (Model.AffectsIntegrity) parts.Add("Integrity");
        if (Model.AffectsAvailability) parts.Add("Availability");
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }
    string StageLabel(ApprovalStage s) => s switch
    {
        ApprovalStage.Technical => "Technical Approval",
        ApprovalStage.Manager => "Manager Approval",
        ApprovalStage.Security => "Security Approval",
        _ => s.ToString()
    };
    static string StepClass(ApprovalDecision d) => d switch
    {
        ApprovalDecision.Approved => "done",
        ApprovalDecision.Rejected => "rej",
        ApprovalDecision.NeedMoreInfo => "info",
        _ => "pending"
    };
    static Microsoft.AspNetCore.Html.IHtmlContent StatusBadge(ExceptionStatus s)
    {
        var cls = s switch
        {
            ExceptionStatus.ActiveException or ExceptionStatus.Renewed => "st-active",
            ExceptionStatus.PendingTechnicalApproval or ExceptionStatus.PendingManagerApproval or ExceptionStatus.PendingSecurityApproval or ExceptionStatus.ExceptionRequested => "st-pending",
            ExceptionStatus.ReviewDue or ExceptionStatus.NeedMoreInfo => "st-warn",
            ExceptionStatus.Expired => "st-expired",
            ExceptionStatus.Rejected => "st-rejected",
            ExceptionStatus.Closed => "st-closed",
            _ => "st-closed"
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"status-badge {cls}\">{VRTrackingApp.Data.Models.ExceptionStatusLabels.For(s)}</span>");
    }
    static Microsoft.AspNetCore.Html.IHtmlContent RiskBadge(RiskLevel? r)
    {
        if (r == null) return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-muted\">—</span>");
        var cls = r switch
        {
            RiskLevel.Low => "risk-low",
            RiskLevel.Medium => "risk-medium",
            RiskLevel.High => "risk-high",
            _ => "risk-critical"
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"risk-badge {cls}\">{r}</span>");
    }
    static Microsoft.AspNetCore.Html.IHtmlContent MitStatus(MitigationStatus s)
    {
        var cls = s switch
        {
            MitigationStatus.Implemented => "st-active",
            MitigationStatus.Pending => "st-pending",
            _ => "st-warn"
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"status-badge {cls}\">{s.Humanize()}</span>");
    }
}

